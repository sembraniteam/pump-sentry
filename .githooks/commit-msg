#!/usr/bin/env bash
#
# commit-msg: Conventional Commits + line-length gate.
#
# Git's native commit-msg hook: runs on every `git commit`, no wrapper.
# Can also be run directly by tooling. Exit 0 valid, 1 invalid.
#
# Messages generated by git itself (Merge/Revert/fixup!/squash!/amend!)
# are not validated.

set -u

MSG_FILE="${1:?usage: commit-msg <message-file>}"
MAX_LEN=75
TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
SUBJECT_RE='^('"$TYPES"')(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]](.*[^.[:space:]])?$'
# Token shapes that must never appear in a commit message either.
MSG_SECRET_RE='AKIA[0-9A-Z]{16}|-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{36,}|xox[baprs]-[A-Za-z0-9-]{10,}|[A-Za-z][A-Za-z0-9+.-]*://[^/[:space:]:@]+:[^/[:space:]@]{6,}@'

# Drop only LEADING blank/comment lines (an editor template). Blank
# lines and comment-looking lines inside the body are content (markdown
# headings, "#123" refs). CRLF is normalized: a hand-written message
# file must validate the same on every platform.
MSG=$(awk 'done || (!/^#/ && !/^[[:space:]]*$/) { done = 1; print }' "$MSG_FILE" | tr -d '\r')
SUBJECT=${MSG%%$'\n'*}

case "$SUBJECT" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

errors=()

# 1. Subject format: <type>[(scope)][!]: <description>, no trailing period
if ! printf '%s\n' "$SUBJECT" | grep -Eq "$SUBJECT_RE"; then
  errors+=("BAD FORMAT: subject must be <type>(scope)!: <description> with no trailing period")
  errors+=("            allowed types: ${TYPES//|/, }")
fi

# 2. Line 2 must be blank (if the message has a body)
SECOND=$(printf '%s\n' "$MSG" | sed -n '2p')
if [ -n "$SECOND" ]; then
  errors+=("Line 2 must be blank (separate subject and body with an empty line)")
fi

# 3. Every line must be at most MAX_LEN characters
n=0
while IFS= read -r line || [ -n "$line" ]; do
  n=$((n + 1))
  if [ "${#line}" -gt "$MAX_LEN" ]; then
    errors+=("TOO LONG (${#line} chars, max $MAX_LEN) on line $n")
  fi
done <<< "$MSG"

# 4. No credential-shaped strings in the message itself
secret_line=$(printf '%s\n' "$MSG" | grep -nE "$MSG_SECRET_RE" | cut -d: -f1 | head -1)
if [ -n "$secret_line" ]; then
  errors+=("SECRET IN MESSAGE: credential-shaped text on line $secret_line (redacted)")
fi

if [ "${#errors[@]}" -gt 0 ]; then
  echo "commit-msg: invalid commit message" >&2
  for e in "${errors[@]}"; do
    echo "  - $e" >&2
  done
  exit 1
fi

exit 0
